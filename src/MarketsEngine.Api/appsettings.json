{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "Trading": {
    "PaperTradingEnabled": true,
    "SlippageBasisPoints": 0,
    "FeePerLot": 20,
    "ShortOptionMarginPerLot": 50000,
    "QuoteStalenessSeconds": 60
  },
  "Kite": {
    "EquityWatchlist": [ "RELIANCE", "TCS", "INFY", "HDFCBANK" ]
  },
  "Strategy": {
    "Enabled": false,
    "ActiveStrategy": "SimpleMomentum",
    "InstrumentKindFilter": "Option",
    "AccountId": null,
    "EvaluationIntervalSeconds": 30,
    "LookbackSamples": 5,
    "QuantityPerSignal": 1,
    "CooldownMinutes": 10,
    "MomentumThresholdPercent": 1.0,
    "KronosServiceUrl": null,
    "KronosForecastHorizon": 12,
    "KronosDirectionThresholdPercent": 0.3,
    // Kronos only - scales its own forecast % move into a take-profit/stop-loss for the position
    // it opens, instead of the flat TakeProfitPercent/StopLossPercent below. E.g. a forecast of
    // +2% with these defaults sets that position's take-profit at 2% and stop-loss at 1%.
    "KronosTakeProfitFactor": 1.0,
    "KronosStopLossFactor": 0.5,
    // Fallback used when the entry signal didn't specify its own stop-loss/take-profit (every
    // SimpleMomentum position, and any Kronos position before this feature existed). Applies to
    // every open position regardless of ActiveStrategy/InstrumentKindFilter.
    "TakeProfitPercent": 10.0,
    "StopLossPercent": 5.0
  },
  "PnLAlerts": {
    "Enabled": false,
    "CheckIntervalMinutes": 15,
    "AlertThresholdAmount": 500,
    "AccountIds": []
  },
  "LiveTrading": {
    "Enabled": false,
    "RequireManualApproval": true,
    "DefaultProduct": "MIS",
    "MaxQuantityPerOrder": 1,
    "MaxNotionalPerOrder": 10000,
    "MaxNotionalPerDay": 25000,
    // Order COUNT cap for today, separate from the ₹ notional cap above - catches a misbehaving
    // strategy loop firing many small orders that would each individually pass the notional check.
    "MaxOrdersPerDay": 20,
    // Trading symbols that must never reach Kite no matter what signals it, e.g.
    // ["NIFTY24NOV24500CE"]. Manual deny-list, case-insensitive, checked before every order.
    "BlockedTradingSymbols": [],
    // A buy may not leave less than this % of pre-trade available Kite cash untouched - a reserve
    // so one bad signal can't spend down to zero spendable cash.
    "CashBufferPercent": 10.0,
    // A single instrument's position (after this fill) may not exceed this % of total account
    // equity (Kite cash + the market value of every open LivePosition) - caps concentration.
    "MaxPositionPercentOfEquity": 50.0,
    "ReconciliationIntervalSeconds": 15,
    "PendingApprovalExpiryMinutes": 30
  }
}
